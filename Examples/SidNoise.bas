1 REM ====================================================
2 REM   C64 RANDOM NUMBER DEMO (COMMODORE BASIC V2)
3 REM ====================================================
4 REM   PART 1: TRNG VIA SID CHIP'S NOISE CHANNEL
5 REM           (READ OSC3 = UPPER 8 BITS OF VOICE 3
6 REM           OSCILLATOR; HARDWARE THERMAL NOISE)
7 REM   PART 2: DETERMINISTIC PRNG VIA BASIC'S RND()
8 REM           (5-BYTE LCG STORED AT $0B-$0F)
9 REM ====================================================
10 PRINT
20 SI = 54272                     : REM $D400 SID BASE
30 POKE SI+14, 255                : REM $D40E V3 FREQ LO = $FF
40 POKE SI+15, 255                : REM $D40F V3 FREQ HI = $FF
50 POKE SI+18, 128                : REM $D412 V3 CTRL = NOISE WAVE
60 PRINT "TRNG (SID NOISE):  ";
70 FOR I = 1 TO 8
80   B = PEEK(SI+27)              : REM $D41B OSC3 OUTPUT
90   GOSUB 1000
100 NEXT I
110 PRINT
120 REM
130 REM ---- DETERMINISTIC PRNG SEEDED WITH -131 ----
140 R = RND(-131)                 : REM NEGATIVE = RE-SEED
150 PRINT "PRNG (RND, SEED -131): ";
160 FOR I = 1 TO 8
170   B = INT(RND(1) * 256)
180   GOSUB 1000
190 NEXT I
200 PRINT
210 END
1000 REM ---- PRINT BYTE 'B' AS 2 PETSCII HEX DIGITS ----
1010 H = INT(B / 16) : L = B - H * 16
1020 IF H < 10 THEN PRINT CHR$(48 + H);: GOTO 1040
1030 PRINT CHR$(55 + H);
1040 IF L < 10 THEN PRINT CHR$(48 + L);: RETURN
1050 PRINT CHR$(55 + L);: RETURN
