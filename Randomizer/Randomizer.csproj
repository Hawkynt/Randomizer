<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Hawkynt</Authors>
    <Description>Shows different implementations of random number generators.</Description>
    <PackageTags>Random;Hawkynt</PackageTags>
    <PackageProjectUrl>https://github.com/Hawkynt/Randomizer</PackageProjectUrl>
    <PackageReadmeFile>..\Readme.md</PackageReadmeFile>

    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>True</PublishTrimmed>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Hawkynt/Randomizer/tree/master/Randomizer</RepositoryUrl>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    ILRepack.FullAuto merges managed dependencies into the main assembly after
    Build. A self-contained / single-file publish copies the .NET runtime's
    NATIVE DLLs (clrgc.dll, coreclr.dll, mscordaccore.dll, …) into the output
    folder; ILRepack cannot merge non-.NET libraries and fails with MSB3073.
    Disable ILRepack for those publish flavours — managed deps are fine to ship
    as separate DLLs inside the single-file bundle.
  -->
  <PropertyGroup>
    <ILRepackBuildEnable Condition="'$(SelfContained)' == 'true' OR '$(PublishSingleFile)' == 'true'">False</ILRepackBuildEnable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FrameworkExtensions.Corlib" Version="1.0.2.*" />
    <PackageReference Include="FrameworkExtensions.System.Drawing" Version="1.0.0.35" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="ILRepack.FullAuto" Version="1.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RandomNumberGenerators\RandomNumberGenerators.csproj" />
  </ItemGroup>

</Project>
